{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracelens",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "docs"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "tracelens.site",
      "zone_name": "tracelens.site",
      "custom_domain": true,
    }
  ]
}
