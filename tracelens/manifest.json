{
  "manifest_version": 3,
  "name": "TraceLens",
  "version": "2.1.0",
  "description": "Read-only network debugging tool for support engineers and developers",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
